AWS_REGION=us-east-1
LOG_LEVEL=INFO

# OpenSearch
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX=jobs
OPENSEARCH_AWS_AUTH=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# SQS (used by local runner and scripts)
SQS_QUEUE_NAME=jobs-indexer-queue
SQS_QUEUE_URL=http://localhost:4566/000000000000/jobs-indexer-queue
AWS_ENDPOINT_URL=http://localhost:4566
